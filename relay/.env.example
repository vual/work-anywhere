RELAY_PUBLIC_URL=http://127.0.0.1:18080
RELAY_LISTEN_ADDR=:8080
DATABASE_URL=postgres://work_anywhere:work_anywhere@postgres:5432/work_anywhere?sslmode=disable
# Generate with: openssl rand -base64 32
RELAY_DATA_KEY=replace-with-32-byte-standard-base64-key
ENROLLMENT_MODE=invite
RELAY_HOST_PORT=18080

# Optional push providers. Mount credential files read-only in production.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_KEY_FILE=/run/secrets/apns_key.p8
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
LOG_LEVEL=info
